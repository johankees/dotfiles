[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[gpg "ssh"]
	defaultKeyCommand = "ssh-sk get --git"

[git-town]
	github-connector = api
    forge-type = github
    github-token = "$(gh auth token)"
